---
import { Icon } from 'astro-icon/components';
import type { Lang } from '../i18n/utils';
import { useTranslations, localizePath } from '../i18n/utils';
import { formatDate } from '../lib/utils';
import BaseLayout from './BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  minutesRead: number;
}

const { title, description, lang, pubDate, updatedDate, tags, minutesRead } =
  Astro.props;
const t = useTranslations(lang);
---

<BaseLayout title={title} description={description} lang={lang} article={true}>
  <article class="mx-auto max-w-3xl px-5 py-16 sm:px-8 md:py-24">
    <a
      href={localizePath('blog', lang)}
      class="inline-flex items-center gap-2 text-sm text-muted transition hover:text-fg"
    >
      <Icon name="lucide:arrow-left" class="size-4" />
      {t('blog.back')}
    </a>

    <header class="mt-8">
      <h1 class="font-display text-3xl font-bold tracking-tight md:text-5xl">
        {title}
      </h1>

      <div
        class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-mono text-faint"
      >
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, lang)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutesRead} {t('blog.readtime')}</span>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                {t('blog.updated')}{' '}
                <time datetime={updatedDate.toISOString()}>
                  {formatDate(updatedDate, lang)}
                </time>
              </span>
            </>
          )
        }
      </div>

      {
        tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li>
                <Badge>{tag}</Badge>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose prose-lg max-w-none mt-10">
      <slot />
    </div>
  </article>
</BaseLayout>
