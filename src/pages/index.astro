---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import About from '../components/home/About.astro';
import ExperienceTimeline from '../components/home/ExperienceTimeline.astro';
import Publications from '../components/home/Publications.astro';
import Skills from '../components/home/Skills.astro';
import Education from '../components/home/Education.astro';
import Awards from '../components/home/Awards.astro';
import BlogPreview from '../components/home/BlogPreview.astro';
import { profile } from '../data/profile';
import type { Lang } from '../i18n/utils';

const lang: Lang = 'en';
---

<BaseLayout
  title="Than Van Hong Son — AI Engineer"
  description={profile.tagline.en}
  lang={lang}
>
  <Hero lang={lang} />
  <About lang={lang} />
  <ExperienceTimeline lang={lang} />
  <Publications lang={lang} />
  <Skills lang={lang} />
  <Education lang={lang} />
  <Awards lang={lang} />
  <BlogPreview lang={lang} />
</BaseLayout>
