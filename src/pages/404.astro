---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { getLangFromUrl, useTranslations, localizePath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={t('notfound.title')} description={t('notfound.text')} lang={lang}>
  <section
    class="bg-grid relative flex min-h-[60vh] flex-col items-center justify-center px-5 py-20 text-center sm:px-8"
  >
    <p class="font-mono text-7xl font-bold tracking-tight sm:text-9xl">
      <span class="text-gradient">404</span>
    </p>
    <h1 class="mt-6 font-display text-3xl font-semibold md:text-4xl">
      {t('notfound.title')}
    </h1>
    <p class="mt-3 max-w-md text-muted">{t('notfound.text')}</p>
    <Button href={localizePath('/', lang)} variant="primary" class="mt-8">
      <Icon name="lucide:arrow-left" class="size-4" />
      {t('notfound.home')}
    </Button>
  </section>
</BaseLayout>
