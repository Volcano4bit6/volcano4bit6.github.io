---
interface Props {
  id?: string;
  kicker?: string;
  title?: string;
  class?: string;
}

const { id, kicker, title, class: className = '' } = Astro.props;
const hasHeader = Boolean(kicker || title);
---

<section id={id} class={`mx-auto max-w-5xl px-5 py-20 sm:px-8 md:py-28 ${className}`}>
  {
    hasHeader && (
      <div class="reveal mb-12 md:mb-16">
        {kicker && <p class="kicker">{kicker}</p>}
        {title && (
          <h2 class="mt-3 font-display text-3xl md:text-5xl">{title}</h2>
        )}
      </div>
    )
  }
  <slot />
</section>
