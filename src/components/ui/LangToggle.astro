---
import { Icon } from 'astro-icon/components';
import { useTranslations, getAlternatePath, type Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const target: Lang = lang === 'en' ? 'vi' : 'en';
const href = getAlternatePath(Astro.url, target);
const code = lang === 'en' ? 'VI' : 'EN';
---

<a
  href={href}
  aria-label={t('lang.toggle')}
  class="grid h-9 place-items-center gap-1 rounded-lg px-2 text-muted transition hover:bg-surface-2 hover:text-fg [grid-auto-flow:column]"
>
  <Icon name="lucide:languages" class="size-5" />
  <span class="font-mono text-xs">{code}</span>
</a>
