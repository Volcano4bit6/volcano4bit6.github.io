---
import type { Lang } from '../../i18n/utils';
import { getAlternatePath } from '../../i18n/utils';
import { profile } from '../../data/profile';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  image?: string;
  article?: boolean;
}

const { title, description, lang, image, article = false } = Astro.props;

const site = Astro.site ?? new URL('https://volcano4bit6.github.io');
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image ?? '/og-image.png', site);
const ogLocale = lang === 'vi' ? 'vi_VN' : 'en_US';

const enHref = new URL(getAlternatePath(Astro.url, 'en'), site).href;
const viHref = new URL(getAlternatePath(Astro.url, 'vi'), site).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: 'AI Engineer',
  url: site.href,
  email: profile.email,
  sameAs: profile.socials.map((s) => s.href),
};
---

<script is:inline>
  const root = document.documentElement;
  // Mark JS as available so scroll-reveal hides only when it can be animated in.
  root.classList.add('js');
  const t = localStorage.getItem('theme');
  if (t === 'light') root.classList.remove('dark');
  else root.classList.add('dark');
</script>

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#08080a" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={profile.name}
  href="/rss.xml"
/>

<link rel="alternate" hreflang="en" href={enHref} />
<link rel="alternate" hreflang="vi" href={viHref} />
<link rel="alternate" hreflang="x-default" href={enHref} />

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={ogImage.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={ogLocale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.href} />

<script type="application/ld+json" set:html={JSON.stringify(personLd)} />
